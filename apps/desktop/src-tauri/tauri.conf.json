{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HARFlow",
  "version": "0.1.0",
  "identifier": "dev.harflow.studio",
  "build": {
    "beforeDevCommand": "pnpm --filter @harflow/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @harflow/web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "HARFlow Studio",
        "width": 1360,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
    }
  }
}
