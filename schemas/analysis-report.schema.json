{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harflow.dev/schemas/analysis-report.schema.json",
  "title": "HARFlow Analysis Report",
  "description": "Structured summary report emitted by harflow-report and consumed by dashboards and CLI.",
  "type": "object",
  "required": ["schemaVersion", "projectId", "generatedAt", "totals", "exportReadiness", "diagnostics"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "projectId": { "type": "string" },
    "generatedAt": { "type": "string" },
    "totals": {
      "type": "object",
      "required": [
        "requests",
        "endpoints",
        "domains",
        "dependencies",
        "authFlows",
        "unknownMappings"
      ],
      "properties": {
        "requests": { "type": "integer", "minimum": 0 },
        "endpoints": { "type": "integer", "minimum": 0 },
        "domains": { "type": "integer", "minimum": 0 },
        "dependencies": { "type": "integer", "minimum": 0 },
        "authFlows": { "type": "integer", "minimum": 0 },
        "unknownMappings": { "type": "integer", "minimum": 0 }
      }
    },
    "exportReadiness": {
      "type": "string",
      "enum": ["not_ready", "partial", "ready"]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message", "relatedEntityIds"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "message": { "type": "string" },
          "relatedEntityIds": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
