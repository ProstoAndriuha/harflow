{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harflow.dev/schemas/api-model.schema.json",
  "title": "HARFlow APIModel",
  "description": "Canonical versioned intermediate API model produced by HARFlow analyzers and consumed by SDK/OpenAPI generators.",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectId",
    "sources",
    "endpoints",
    "schemas",
    "dependencies",
    "authFlows",
    "workflows",
    "diagnostics",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/SessionSource" }
    },
    "endpoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/Endpoint" }
    },
    "schemas": {
      "type": "array",
      "items": { "$ref": "#/$defs/SchemaDefinition" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/Dependency" }
    },
    "authFlows": {
      "type": "array",
      "items": { "$ref": "#/$defs/AuthFlow" }
    },
    "workflows": {
      "type": "array",
      "items": { "$ref": "#/$defs/Workflow" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/Diagnostic" }
    },
    "metadata": { "$ref": "#/$defs/ModelMetadata" }
  },
  "$defs": {
    "SessionSource": {
      "type": "object",
      "required": ["id", "name", "importedAt", "entryCount", "redactedSecretsCount"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "harVersion": { "type": "string" },
        "importedAt": { "type": "string" },
        "entryCount": { "type": "integer", "minimum": 0 },
        "redactedSecretsCount": { "type": "integer", "minimum": 0 }
      }
    },
    "EndpointParameter": {
      "type": "object",
      "required": ["name", "location", "inferredType", "required", "observedCount"],
      "properties": {
        "name": { "type": "string" },
        "location": { "type": "string", "enum": ["path", "query", "header", "cookie"] },
        "inferredType": { "type": "string" },
        "required": { "type": "boolean" },
        "observedCount": { "type": "integer", "minimum": 0 }
      }
    },
    "Endpoint": {
      "type": "object",
      "required": [
        "id",
        "method",
        "host",
        "pathTemplate",
        "parameters",
        "statusCodes",
        "confidence",
        "category",
        "observedRequestIds"
      ],
      "properties": {
        "id": { "type": "string" },
        "operationId": { "type": "string" },
        "method": { "type": "string" },
        "host": { "type": "string" },
        "pathTemplate": { "type": "string" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/EndpointParameter" }
        },
        "requestSchemaId": { "type": ["string", "null"] },
        "responseSchemaId": { "type": ["string", "null"] },
        "statusCodes": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "category": { "type": "string" },
        "observedRequestIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "SchemaDefinition": {
      "type": "object",
      "required": ["id", "name", "rootType", "fields", "observationCount"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "rootType": { "type": "string" },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "inferredType", "required", "nullable", "observedCount"],
            "properties": {
              "name": { "type": "string" },
              "inferredType": { "type": "string" },
              "required": { "type": "boolean" },
              "nullable": { "type": "boolean" },
              "observedCount": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "observationCount": { "type": "integer", "minimum": 0 }
      }
    },
    "ValueReference": {
      "type": "object",
      "required": ["sessionId", "requestId", "location", "jsonPathOrKey"],
      "properties": {
        "sessionId": { "type": "string" },
        "requestId": { "type": "string" },
        "location": {
          "type": "string",
          "enum": [
            "path",
            "query",
            "header",
            "cookie",
            "body",
            "set_cookie",
            "response_header",
            "response_body"
          ]
        },
        "jsonPathOrKey": { "type": "string" }
      }
    },
    "Dependency": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "type",
        "confidence",
        "status",
        "evidence",
        "observedSessionIds"
      ],
      "properties": {
        "id": { "type": "string" },
        "source": { "$ref": "#/$defs/ValueReference" },
        "target": { "$ref": "#/$defs/ValueReference" },
        "type": {
          "type": "string",
          "enum": [
            "response_to_header",
            "response_to_query",
            "response_to_body",
            "response_to_path",
            "set_cookie_to_cookie",
            "pagination_chain",
            "session_chain",
            "derived_value"
          ]
        },
        "transformation": {
          "type": ["string", "null"],
          "enum": [
            "identity",
            "url_encoding",
            "base64",
            "prefix_suffix",
            "json_extract",
            "custom",
            null
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": {
          "type": "string",
          "enum": ["confirmed", "likely", "unknown", "rejected", "user_confirmed"]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/Evidence" }
        },
        "observedSessionIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "Evidence": {
      "type": "object",
      "required": ["sessionId", "requestId", "ruleId", "description", "observedAt"],
      "properties": {
        "sessionId": { "type": "string" },
        "requestId": { "type": "string" },
        "ruleId": { "type": "string" },
        "description": { "type": "string" },
        "observedAt": { "type": "string" }
      }
    },
    "AuthFlow": {
      "type": "object",
      "required": ["id", "scheme", "description", "requestIds", "confidence"],
      "properties": {
        "id": { "type": "string" },
        "scheme": {
          "type": "string",
          "enum": ["bearer", "cookie_session", "csrf", "oauth_like", "api_key", "unknown"]
        },
        "description": { "type": "string" },
        "requestIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "Workflow": {
      "type": "object",
      "required": ["id", "name", "stepEndpointIds"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "stepEndpointIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "Diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message", "relatedEntityIds"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "relatedEntityIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "ModelMetadata": {
      "type": "object",
      "required": ["projectName", "generatedAt", "generatorVersion", "totalRequests"],
      "properties": {
        "projectName": { "type": "string" },
        "generatedAt": { "type": "string" },
        "generatorVersion": { "type": "string" },
        "totalRequests": { "type": "integer", "minimum": 0 },
        "excludedRequests": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
